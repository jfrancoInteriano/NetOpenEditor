@model QuoteForm
@{
    ViewData["Title"] = "Cotización";
}
<h1>Cotización</h1>
<form method="post" id="quoteForm">
    <div class="card">
        <div asp-validation-summary="All"></div>
        <label>Cliente</label>
        <input class="hdr" asp-for="CustomerName" />
        <input type="hidden" asp-for="Id" />
        <label>Moneda</label>
        <select class="hdr" id="currency">
            <option value="HNL">HNL</option>
            <option value="USD">USD</option>
        </select>
        <label>Proveedor</label>
        <select class="hdr" asp-for="ProviderId" id="provider">
            <option value="PROV-A">Proveedor A</option>
            <option value="PROV-B">Proveedor B</option>
        </select>
    </div>
    <div class="card">
        @if (ViewData["LoadFromSource"] is true)
        {
            @* GET: the lines come from the registered line source, keyed by the document id. *@
            <netopen-editor editor-id="quote-lines" key="@Model.Id" name-prefix="Lines" />
        }
        else
        {
            @* POST re-render: show what the user typed, never what the database holds. *@
            <netopen-editor editor-id="quote-lines" rows="Model.Lines" name-prefix="Lines" />
        }
    </div>
    <div class="card">Total: <span id="grand-total">0.00</span></div>
    <button type="submit" class="btn" id="save">Guardar</button>
</form>
<script>
    document.addEventListener('alpine:init', () => {
        NetOpenEditor.configure('quote-lines', {
            onLookupSelected(row, field, item, editor) {
                if (field !== 'ProductId') return;
                row.UnitPrice = item.price;
                row.TaxRate = item.taxRate;
                if (editor.num(row.Quantity) === 0) row.Quantity = 1;
            },
            // Typing the printed total back-solves the unit price; the editor never writes the
            // computed cell itself, so compute() stays the single owner of its value.
            onComputedInput(row, field, value, editor) {
                if (field === 'DiscountShown') {
                    const typed = editor.num(value);
                    const gross = editor.num(row.Quantity) * editor.num(row.UnitPrice);
                    // What the box means depends on the row's mode; what we post never does.
                    row.DiscountPercent = row.__host.discountUnit === 'money'
                        ? (gross > 0 ? Math.min(100, Math.round(typed / gross * 1000000) / 10000) : 0)
                        : typed;
                    return;
                }
                if (field !== 'LineTotal') return;
                const total = editor.num(value);
                const qty = editor.num(row.Quantity);
                const taxed = 1 + editor.num(row.TaxRate) / 100;
                if (qty > 0 && taxed > 0) {
                    row.UnitPrice = Math.round((total / (qty * taxed)) * 10000) / 10000;
                    row.__host.priceDerived = true;
                }
            },
            // The button's label is the row's current unit, and the host owns that state.
            adornmentLabel(row, field, editor) {
                return row.__host.discountUnit === 'money' ? (document.getElementById('currency')?.value || 'HNL') : '%';
            },
            onAdornment(row, field, editor) {
                const toMoney = row.__host.discountUnit !== 'money';
                const base = editor.num(row.Quantity) * editor.num(row.UnitPrice);
                row.__host.discountUnit = toMoney ? 'money' : 'percent';
                // Keep the posted field a percentage either way: convert what is on screen.
                if (toMoney) row.__host.discountMoney = base * editor.num(row.DiscountPercent) / 100;
                else row.__host.discountMoney = null;
            },
            compute(row, editor) {
                // The posted percentage is hidden, so nothing on screen can fill it in: a line the
                // user never discounted must still post a number, not the blank the row starts with.
                row.DiscountPercent = editor.num(row.DiscountPercent);
                const gross = editor.num(row.Quantity) * editor.num(row.UnitPrice);
                row.DiscountShown = row.__host.discountUnit === 'money'
                    ? gross * editor.num(row.DiscountPercent) / 100
                    : editor.num(row.DiscountPercent);
                row.LineTotal = editor.num(row.Quantity) * editor.num(row.UnitPrice) * (1 + editor.num(row.TaxRate) / 100);
            }
        });
    });
    // noe:ready fires once after hydration; without it a form whose lines come preloaded
    // (from the line source) would show 0.00 until the user touched a cell.
    const paintQuoteTotal = (e) => {
        if (e.detail.id !== 'quote-lines') return;
        document.getElementById('grand-total').textContent = (e.detail.totals.LineTotal || 0).toFixed(2);
    };
    // The currency lives outside the editor, so tell it when the label source changes.
    document.getElementById('currency').addEventListener('change', () => NetOpenEditor.get('quote-lines').refresh());
    document.addEventListener('noe:ready', paintQuoteTotal);
    document.addEventListener('noe:change', paintQuoteTotal);
</script>
